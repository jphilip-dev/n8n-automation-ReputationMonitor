        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Thank You for Your Feedback</title>\n  <style>\n    :root {\n      --bg: {{ $json.bg }};\n      --card: {{ $json.card }};\n      --muted: {{ $json.muted }};\n      --border: {{ $json.border }};\n      --radius: {{ $json.radius }};\n      --shadow: {{ $json.shadow }};\n      --maxw: {{ $json.maxw }};\n    }\n\n    * { box-sizing: border-box; }\n    html, body { height: 100%; }\n\n    body {\n      margin: 0;\n      font: 16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Helvetica, Arial;\n      background: var(--bg);\n      color: var(--text);\n      display: grid;\n      place-items: center;\n      padding: 24px;\n    }\n\n    .card {\n      width: 100%;\n      max-width: var(--maxw);\n      background: var(--card);\n      border: 1px solid var(--border);\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      padding: 40px 28px;\n      text-align: center;\n    }\n\n    h1 {\n      font-size: 1.6rem;\n      color: #ffffff;\n    }\n\n    p.sub {\n      color: var(--muted);\n      font-size: 1rem;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Thank You!</h1>\n    <p class=\"sub\">We appreciate your feedback — it helps us improve our service.</p>\n  </main>\n</body>\n</html>"
