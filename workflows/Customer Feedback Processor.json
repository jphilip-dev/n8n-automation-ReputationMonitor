        "inputSchema": "\n{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Positive\",\n        \"Neutral\",\n        \"Negative\",\n        \"Not Analyzed\"\n      ]\n    },\n    \"categories\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"Food/Product Quality\",\n          \"Customer Service\",\n          \"Waiting Time\",\n          \"Cleanliness\",\n          \"Price/Value\",\n          \"Staff Behavior\",\n          \"Overall Experience\",\n          \"Other\",\n          \"None\"\n        ]\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"key_issue\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"High\",\n        \"Medium\",\n        \"Low\",\n        \"None\"\n      ]\n    },\n    \"customer_response\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"sentiment\",\n    \"categories\",\n    \"summary\",\n    \"key_issue\",\n    \"recommended_action\",\n    \"priority\",\n    \"customer_response\"\n  ],\n  \"additionalProperties\": false\n}\n",
